{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mukdong-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:offline"
      ],
      "port": 5371
    },
    {
      "name": "mukdong-online",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191
    },
    {
      "name": "mukdong-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "5192",
        "--strictPort"
      ],
      "port": 5192
    }
  ]
}